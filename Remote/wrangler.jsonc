{
  "name": "pika-remote",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "Room"}, {"name": "ADMISSION", "class_name": "Admission"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room", "Admission"]}],
  "ratelimits": [{"name": "PAIR_LIMITER", "namespace_id": "1002", "simple": {"limit": 3, "period": 60}},{"name": "LIMITER", "namespace_id": "1001", "simple": {"limit": 30, "period": 60}}],
  "observability": {"enabled": false}
}
